# Copy to terraform.tfvars (git-ignored) and fill in. The Mailgun key is not a
# Terraform input: add it to the Secret Manager secret after the first apply
# (see the mailgun_secret output).
project_id     = "my-gcp-project"
region         = "us-central1"
mailgun_domain = "mail.example.com"
mailgun_from   = "scorer <scorer@mail.example.com>"
